# Azure Identity
# Local development with `az login`: leave AZURE_CLIENT_ID empty.
# Azure deployment with a user-assigned managed identity: set its client ID.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=

# ── Microsoft Foundry Agent Service runtime ─────────────────
# Required by both the Container Apps control plane and Hosted Agent runtime.
# No direct Azure OpenAI/OpenAI endpoint or key is used.
FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project

# Required by Container App and scheduler. They fail closed instead of running
# the LangGraph analyzer locally. The name must match the azure.yaml service.
FOUNDRY_HOSTED_AGENT_NAME=azbrief-analysis-hosted
FOUNDRY_HOSTED_AGENT_TIMEOUT_S=1800

# Required inside the Hosted Agent (and for direct local analyzer scripts):
# G-Eval, action verification, and fallback for every optional Prompt Agent role.
FOUNDRY_PRIMARY_AGENT_NAME=azbrief-primary

# Optional role-specific agents. Leave empty to use FOUNDRY_PRIMARY_AGENT_NAME.
FOUNDRY_PLANNER_AGENT_NAME=
FOUNDRY_EVALUATOR_AGENT_NAME=
FOUNDRY_REPORTER_AGENT_NAME=
FOUNDRY_CODEX_AGENT_NAME=
FOUNDRY_FAST_AGENT_NAME=
FOUNDRY_AGENT_TIMEOUT_S=180

# Provisioning only: model assigned when scripts/provision_foundry_agents.py
# creates or updates agents. The running app never calls this deployment directly.
FOUNDRY_MODEL_DEPLOYMENT=gpt-4o

# Optional pre-analysis enrichment pipeline. Provisioning publishes app-owned
# read-only FunctionTools for research/impact plus strict stage JSON schemas.
# Managed Web/MCP/memory tools remain optional and are preserved across versions.
# research + impact run in parallel, followed by action and review. Enable only
# after `python -m scripts.provision_foundry_agents --check` passes.
# FOUNDRY_ENRICHMENT_AGENTS=[{"name":"azbrief-research","stage":"research"},{"name":"azbrief-impact","stage":"impact"},{"name":"azbrief-action","stage":"action"},{"name":"azbrief-review","stage":"review"}]

# Prompt Agent server tools provisioned by scripts/provision_foundry_agents.py.
# Research always receives Microsoft Learn MCP first. When enabled, Web Search
# supplements only facts that Learn does not establish and can incur Bing costs.
FOUNDRY_RESEARCH_WEB_SEARCH_ENABLED=true
# Set both values after deploying infra/azure-mcp-server. The connection uses
# the Foundry project managed identity and the MCP Container App's Entra audience.
AZURE_MCP_SERVER_URL=
AZURE_MCP_PROJECT_CONNECTION_NAME=azbrief-azure-mcp-read-only

# azure.yaml maps non-reserved AZBRIEF_* aliases into the Hosted container.
# Set these in the azd environment before `azd deploy`; optional roles fall back
# to AZBRIEF_PROMPT_PRIMARY_AGENT_NAME when omitted.
# AZBRIEF_PROMPT_PRIMARY_AGENT_NAME=azbrief-primary
# AZBRIEF_PROMPT_PLANNER_AGENT_NAME=azbrief-planner
# AZBRIEF_PROMPT_EVALUATOR_AGENT_NAME=azbrief-evaluator
# AZBRIEF_PROMPT_REPORTER_AGENT_NAME=azbrief-reporter
# AZBRIEF_PROMPT_CODEX_AGENT_NAME=azbrief-codex
# AZBRIEF_PROMPT_FAST_AGENT_NAME=azbrief-fast
# AZBRIEF_ENRICHMENT_AGENT_ROSTER=[{"name":"azbrief-research","stage":"research"},{"name":"azbrief-impact","stage":"impact"},{"name":"azbrief-action","stage":"action"},{"name":"azbrief-review","stage":"review"}]

# ── Durable digest checkpoint ───────────────────────────────
# The "analysed up to" watermark. Written with the managed identity; the
# Container Apps Job and the Container App share the same blob.
# CHECKPOINT_BLOB_URL=https://<account>.blob.core.windows.net/azbrief-state/checkpoint.json
# Local development fallback, used only when CHECKPOINT_BLOB_URL is unset.
# CHECKPOINT_FILE_PATH=data/checkpoint.json

# Only needed when an external scheduler drives runs over HTTP instead of the
# built-in Container Apps Job.
# ORCHESTRATOR_ENDPOINT=https://ca-azbrief.<region>.azurecontainerapps.io
# ORCHESTRATOR_API_KEY=
# ORCHESTRATOR_TIMEOUT_S=120

# Key required on every /api/* route (X-API-Key header). Unset = endpoints are open.
# API_KEY=

# ── Admin console (fails closed) ────────────────────────────
# Both flags must be satisfied for /admin to serve anything: the console must be
# enabled AND the signed-in principal must appear in the allow-list. Identity comes
# from Container Apps built-in Entra ID authentication.
ADMIN_UI_ENABLED=false
ADMIN_REQUIRE_AUTH=true
# ADMIN_ALLOWED_PRINCIPALS=admin@your-company.com,00000000-0000-0000-0000-000000000000

# Azure Communication Services (optional — if not set, output to console)
COMMUNICATION_SERVICES_CONNECTION_STRING=
# Managed-identity alternative to the connection string (no stored email secret)
# COMMUNICATION_SERVICES_ENDPOINT=https://your-acs.communication.azure.com
EMAIL_SENDER_ADDRESS=DoNotReply@your-domain.azurecomm.net
EMAIL_RECIPIENT_ADDRESS=admin@your-company.com

# Log Analytics (optional — for querying operational logs)
LOG_ANALYTICS_WORKSPACE_ID=

# Custom Prompt (additional analysis instructions — customer info, special regulations, etc.)
# Example: CUSTOM_SYSTEM_PROMPT=This environment is for a financial customer (Bank A). PCI-DSS compliance is mandatory. Include financial security perspectives in all analyses.
CUSTOM_SYSTEM_PROMPT=

# Report Language (default language for analysis reports: ko, en, ja)
REPORT_LANGUAGE=ko

# Subscribers (personalized reports per subscriber — JSON array)
# When set, sends role-customized reports to each subscriber instead of EMAIL_RECIPIENT_ADDRESS.
# language: report language per subscriber (default: ko). e.g., ko, en, ja
# Example: SUBSCRIBERS=[{"email":"infra@co.com","name":"Alice","role":"Azure Infra Management (VM, Network)","language":"ko"},{"email":"eng@co.com","name":"John","role":"Cloud Architect","language":"en"}]
SUBSCRIBERS=

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE_ENABLED=true
LOG_FILE_DIR=logs
LOG_CONSOLE_LEVEL=

# ── Azure Monitor Ingestion (optional — send structured logs to Log Analytics) ──
AZURE_MONITOR_INGESTION_ENDPOINT=
AZURE_MONITOR_DCR_RULE_ID=
AZURE_MONITOR_DCR_STREAM_NAME=Custom-AzBrief_CL

# ── OpenTelemetry tracing (optional) ─────────────────────────
# When enabled with a connection string, the analysis transaction and every tool
# call are exported as spans to Application Insights.
OTEL_ENABLED=false
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ── Report quality & agent trajectory evaluation ──────────
# GEVAL_ENABLED: LLM-as-a-Judge report quality scoring in the improvement loop.
# GEVAL_RUNTIME_ENABLED: also run the judge inside analyze_update and let it
#   drive ONE report rewrite when the score misses GEVAL_TARGET_SCORE. Costs
#   roughly two extra LLM calls per update, which competes with RUN_TIME_BUDGET_S
#   — off by default.
# TRAJECTORY_EVAL_ENABLED: rule-based agent process-quality score after each analysis.
GEVAL_ENABLED=true
GEVAL_TARGET_SCORE=4.5
GEVAL_RUNTIME_ENABLED=false
TRAJECTORY_EVAL_ENABLED=true

# ── Action-item safety gate (multi-layer verification) ────
# Action items are executed against production, so they pass a 3-layer gate:
# deterministic static checks, an adversarial LLM cross-check, and a status
# policy that withholds commands on a blocking verdict.
# ACTION_VERIFICATION_ENABLED=false turns the whole gate off (not recommended).
# ACTION_VERIFICATION_CROSS_CHECK=false keeps the static layer but skips the
#   extra LLM call; items then stay "unverified" instead of "verified".
# ACTION_VERIFICATION_WITHHOLD_COMMANDS=false still shows the blocked verdict
#   but leaves the CLI command visible.
ACTION_VERIFICATION_ENABLED=true
ACTION_VERIFICATION_CROSS_CHECK=true
ACTION_VERIFICATION_WITHHOLD_COMMANDS=true

# ── Practitioner commentary (third-party, read-only) ──────
# Enriches analyses with community write-ups (Azure Weekly digest), and pulls
# the full article body from Microsoft Tech Community board feeds for the top
# matches to extract stated prerequisites and trade-offs.
# COMMUNITY_INSIGHTS_FULL_TEXT=0 disables full-text retrieval only.
COMMUNITY_INSIGHTS_ENABLED=true
COMMUNITY_INSIGHTS_FULL_TEXT=2

# ── Controlled autonomy (human-in-the-loop) ───────────────
# When true, reports are never auto-sent by email; the rendered report is saved
# to out/ and logged as pending approval for a human to review and send manually.
REQUIRE_APPROVAL_BEFORE_SEND=false

# ── Run execution budget ──────────────────────────────────────────
# MAX_CONCURRENT_ANALYSES: updates analyzed in parallel (1 = sequential).
# RUN_TIME_BUDGET_S: wall-clock budget for one run. Keep it below the Container
#   Apps Job replicaTimeout (12h by default) so updates that no longer fit are
#   deferred to the next run and the checkpoint is held back for them, instead
#   of the replica being killed mid-analysis. Set to 0 to disable.
MAX_CONCURRENT_ANALYSES=3
RUN_TIME_BUDGET_S=39600

# ── Verbose console output (set false in production) ───────
AZBRIEF_VERBOSE=true

# Application Settings
LOG_LEVEL=INFO
# LOG_CONSOLE_LEVEL=CRITICAL       # Override console output level (default: same as LOG_LEVEL)
# LOG_FILE_ENABLED=true            # Enable/disable file logging (default: true)
# LOG_FILE_DIR=logs                # Log file directory (default: logs/)

# Azure Monitor Log Ingestion (optional — send structured logs to Azure Monitor / Log Analytics)
# Requires: Data Collection Endpoint (DCE) + Data Collection Rule (DCR) configured in Azure Monitor.
# See: https://learn.microsoft.com/azure/azure-monitor/logs/tutorial-logs-ingestion-portal
# AZURE_MONITOR_INGESTION_ENDPOINT=https://your-dce.koreacentral-1.ingest.monitor.azure.com
# AZURE_MONITOR_DCR_RULE_ID=dcr-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AZURE_MONITOR_DCR_STREAM_NAME=Custom-AzBrief_CL
