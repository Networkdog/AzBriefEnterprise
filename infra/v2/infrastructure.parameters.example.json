{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": { "value": "koreacentral" },
    "virtualNetworkMode": { "value": "existing" },
    "virtualNetworkResourceGroupName": { "value": "<existing-network-resource-group>" },
    "virtualNetworkName": { "value": "<approved-existing-vnet>" },
    "peSubnetName": { "value": "<private-endpoint-subnet>" },
    "foundrySubnetName": { "value": "<foundry-injection-subnet>" },
    "containerAppsSubnetName": { "value": "<container-apps-subnet>" },
    "foundryAccountName": { "value": "<new-foundry-account>" },
    "storageAccountName": { "value": "<new-storage-account>" },
    "useMicrosoftManagedAgentData": { "value": true },
    "projectName": { "value": "<new-foundry-project>" },
    "containerAppsEnvironmentName": { "value": "<new-private-environment>" },
    "containerAppName": { "value": "<new-container-app>" },
    "schedulerJobName": { "value": "<customer-scheduler-job>" },
    "controlPlaneIdentityName": { "value": "<customer-control-plane-identity>" },
    "logAnalyticsWorkspaceName": { "value": "<customer-log-workspace>" },
    "applicationInsightsName": { "value": "<customer-insights>" },
    "communicationServicesName": { "value": "<customer-communication-service>" },
    "emailServiceName": { "value": "<customer-email-service>" },
    "azureMcpContainerAppName": { "value": "<customer-mcp-app>" },
    "azureMcpIdentityName": { "value": "<customer-mcp-identity>" }
  }
}