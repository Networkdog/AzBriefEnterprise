{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": { "value": "koreacentral" },
    "virtualNetworkResourceGroupName": { "value": "<existing-network-resource-group>" },
    "virtualNetworkName": { "value": "<approved-existing-vnet>" },
    "peSubnetName": { "value": "<private-endpoint-subnet>" },
    "foundrySubnetName": { "value": "<foundry-injection-subnet>" },
    "containerAppsSubnetName": { "value": "<container-apps-subnet>" },
    "foundryAccountName": { "value": "<new-foundry-account>" },
    "storageAccountName": { "value": "<new-storage-account>" },
    "cosmosAccountName": { "value": "<new-cosmos-account>" },
    "searchServiceName": { "value": "<new-search-service>" },
    "projectName": { "value": "<new-foundry-project>" },
    "containerAppsEnvironmentName": { "value": "<new-private-environment>" },
    "containerAppName": { "value": "<new-container-app>" },
    "azureMcpServerUrl": { "value": "<approved-existing-https-mcp-url>" },
    "azureMcpProjectConnectionName": { "value": "<approved-project-mcp-connection-name>" }
